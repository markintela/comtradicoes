# ─────────────────────────────────────────────────────────────
#  Configuração do SERVIDOR (dados secretos — nunca no browser)
#  Copie este ficheiro para ".env" e preencha.
# ─────────────────────────────────────────────────────────────

# Porta do servidor
PORT=3001

# Modo de demonstração: "true" simula os pedidos (não cobra nada).
# Mude para "false" quando tiver a chave MB WAY do fornecedor.
MBWAY_MOCK=true

# Chave MB WAY atribuída pela ifthenpay (ex.: ABC-123456)
MBWAY_KEY=

# Endpoints da API MB WAY v2 da ifthenpay
# (confirme-os com a ifthenpay ao ativar a conta)
MBWAY_API_URL=https://api.ifthenpay.com/spg/payment/mbway
MBWAY_STATUS_URL=https://api.ifthenpay.com/spg/payment/mbway/status

# Chave anti-phishing do callback (opcional; definida no backoffice ifthenpay)
MBWAY_CALLBACK_KEY=
